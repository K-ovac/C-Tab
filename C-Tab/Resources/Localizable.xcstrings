    "coinDetails.stat.circulatingSupply" : {
      "comment" : "Title of a coin statistics item.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circulating Supply"
          }
        },
        "fr" : {
